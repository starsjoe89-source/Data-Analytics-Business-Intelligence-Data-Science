## 6. Productos con baja rotación
 Últimos 90 días del dataset
max_date   = df_clean['InvoiceDate'].max()
cutoff_90d = max_date - pd.Timedelta(days=90)

recent_sales = df_clean[df_clean['InvoiceDate'] >= cutoff_90d]

# Productos con al menos 1 venta histórica pero menos de 5 unidades en últimos 90 días
all_products = df_clean.groupby('StockCode')['Quantity'].sum().rename('total_qty')
recent_qty   = recent_sales.groupby('StockCode')['Quantity'].sum().rename('recent_qty')

rotation = pd.concat([all_products, recent_qty], axis=1).fillna(0)
low_rot  = rotation[(rotation['total_qty'] > 20) & (rotation['recent_qty'] < 5)].copy()
low_rot  = low_rot.join(
    df_clean.drop_duplicates('StockCode').set_index('StockCode')['Description']
).sort_values('recent_qty').head(20)

print(f'Productos con baja rotación detectados: {len(low_rot)}')
print(low_rot[['Description','total_qty','recent_qty']].head(10).to_string())

## 7. RFM — Segmentación de clientes
snapshot_date = max_date + pd.Timedelta(days=1)

rfm = (
    df_clean.groupby('Customer ID')
    .agg(
        Recency   =('InvoiceDate', lambda x: (snapshot_date - x.max()).days),
        Frequency =('Invoice',     'nunique'),
        Monetary  =('Revenue',     'sum')
    )
    .reset_index()
)

# Scores 1-5 (quintiles)
rfm['R_score'] = pd.qcut(rfm['Recency'],   5, labels=[5,4,3,2,1]).astype(int)
rfm['F_score'] = pd.qcut(rfm['Frequency'].rank(method='first'), 5, labels=[1,2,3,4,5]).astype(int)
rfm['M_score'] = pd.qcut(rfm['Monetary'],  5, labels=[1,2,3,4,5]).astype(int)
rfm['RFM_score'] = rfm['R_score'].astype(str) + rfm['F_score'].astype(str) + rfm['M_score'].astype(str)

# Segmentos
def segment(row):
    r, f, m = row['R_score'], row['F_score'], row['M_score']
    if r >= 4 and f >= 4 and m >= 4: return 'Champions'
    elif r >= 3 and f >= 3:          return 'Leales'
    elif r >= 4 and f <= 2:          return 'Potenciales'
    elif r == 2:                     return 'En riesgo'
    elif r == 1 and f >= 3:          return 'No puedo perderlos'
    else:                            return 'Hibernando'

rfm['Segment'] = rfm.apply(segment, axis=1)

summary = rfm.groupby('Segment').agg(
    Clientes     =('Customer ID','count'),
    Revenue_avg  =('Monetary','mean'),
    Revenue_total=('Monetary','sum'),
    Recency_avg  =('Recency','mean'),
    Freq_avg     =('Frequency','mean')
).round(1)

print(summary.to_string())

# Visualización RFM
seg_counts = rfm['Segment'].value_counts()
fig, ax = plt.subplots(figsize=(8, 5))
colors = [PALETTE[i % len(PALETTE)] for i in range(len(seg_counts))]
